{
  "name": "workflow",
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=web\" \"npm run dev --workspace=server\"",
    "build": "concurrently \"npm run build --workspace=web\" \"npm run build --workspace=server\"",
    "start": "concurrently \"npm run start --workspace=web\" \"npm run start --workspace=server\""
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
